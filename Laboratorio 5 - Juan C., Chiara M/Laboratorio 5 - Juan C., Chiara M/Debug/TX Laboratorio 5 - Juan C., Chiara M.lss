                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;===============================================================================
                                 ; LABORATORIO 5 - Enlace serial USART entre dos microcontroladores
                                 ;
                                 ; DESCRIPCIÓN GENERAL:
                                 ; El programa permite transmitir y recibir un bloque de 512 bytes mediante
                                 ; comunicación USART. Al finalizar la transmisión se envía un checksum de
                                 ; 32 bits que permite comprobar si los datos llegaron correctamente.
                                 ;
                                 ; ORGANIZACIÓN DE LAS RUTINAS:
                                 ;
                                 ;   generar_...       Generación de datos pseudoaleatorios.
                                 ;   calcular_...      Cálculo del checksum del mensaje.
                                 ;   enviar_...        Transmisión de información por USART.
                                 ;   recibir_...       Recepción de información por USART.
                                 ;   verificar_...     Comprobación de los datos recibidos.
                                 ;   esperar_...       Esperas y control de los botones.
                                 ;   mostrar_...       Control del display de siete segmentos.
                                 ;   int_...           Rutinas asociadas a las interrupciones.
                                 ;
                                 ; RUTINAS DEL PROGRAMA:
                                 ;
                                 ; generar_aleatorios:
                                 ;   Completa el espacio mensaje_512 con 512 bytes generados mediante
                                 ;   el algoritmo XORSHIFT de 32 bits.
                                 ;
                                 ; calcular_checksum:
                                 ;   Suma todos los bytes almacenados en mensaje_512.
                                 ;   El resultado se guarda en r7:r6:r5:r4.
                                 ;   Los dos bytes inferiores (r5:r4) se utilizan para el display.
                                 ;
                                 ; enviar_mensaje:
                                 ;   Envía los 512 bytes del mensaje y posteriormente los cuatro bytes
                                 ;   correspondientes al checksum.
                                 ;
                                 ; recibir_mensaje:
                                 ;   Almacena los 512 bytes recibidos y luego guarda el checksum
                                 ;   enviado por la otra placa.
                                 ;
                                 ; verificar_checksum:
                                 ;   Compara el resultado local con el valor recibido y actualiza
                                 ;   los indicadores luminosos según el resultado.
                                 ;
                                 ; int_botones:
                                 ;   Detecta la pulsación de cualquiera de los tres botones.
                                 ;
                                 ; int_timer_display:
                                 ;   Actualiza periódicamente el display, mostrando los 16 bits
                                 ;   inferiores del checksum.
                                 ;
                                 ; mostrar_digito / enviar_byte_display / tabla_7segmentos:
                                 ;   Se encargan de controlar los registros de desplazamiento 74HC595
                                 ;   utilizados por el display.
                                 ;
                                 ;-------------------------------------------------------------------------------
                                 ; DISTRIBUCIÓN DE REGISTROS
                                 ;
                                 ; r7:r6:r5:r4     Resultado del checksum de 32 bits.
                                 ;                  r5:r4 se utilizan para actualizar el display.
                                 ;
                                 ; r25              Selección del dígito que se encuentra activo.
                                 ;
                                 ; r26              Bandera de pulsación de botones (bit 0).
                                 ;
                                 ; r11:r10:r9:r8    Estado del generador XORSHIFT entre transmisiones.
                                 ;
                                 ; r15:r14:r13:r12  Acumulador auxiliar para calcular el checksum.
                                 ;
                                 ; r19:r18:r17:r16  Registros de uso general durante la generación.
                                 ;
                                 ; r18              Indicadores de errores de recepción:
                                 ;                    bit 4: error de trama (FE0)
                                 ;                    bit 3: pérdida de datos (DOR0)
                                 ;                    bit 2: error de paridad (UPE0)
                                 ;                    bit 7: tiempo de espera agotado.
                                 ;
                                 ;-------------------------------------------------------------------------------
                                 ; INDICADORES DEL RECEPTOR
                                 ;
                                 ; PB5  Resultado correcto del checksum.
                                 ; PB4  Diferencia entre el checksum calculado y el recibido.
                                 ; PB3  Error detectado durante la recepción serial.
                                 ;
                                 ; Los LEDs funcionan con lógica activa en cero.
                                 ;
                                 ;-------------------------------------------------------------------------------
                                 ; CONFIGURACIÓN DE VELOCIDAD
                                 ;
                                 ; Frecuencia del microcontrolador: 16 MHz.
                                 ;
                                 ; 9600 baudios    UBRR = 103   U2X = 0
                                 ; 250000 baudios  UBRR = 3     U2X = 0
                                 ; 500000 baudios  UBRR = 1     U2X = 0
                                 ; 1 Mbaud         UBRR = 0     U2X = 0
                                 ; 2 Mbaud         UBRR = 0     U2X = 1
                                 ;
                                 ; Con paridad habilitada, cada trama contiene:
                                 ; 1 bit de inicio + 8 bits de datos + 1 bit de paridad + 1 bit de parada.
                                 ;===============================================================================
                                 
                                 
                                 ;===============================================================================
                                 ; PARÁMETROS GENERALES
                                 ;===============================================================================
                                 
                                 .equ VALOR_UBRR = 103          ; Divisor para una velocidad de 9600 baudios.
                                 .equ VALOR_U2X  = 0            ; Selección del modo normal de transmisión.
                                 
                                 ; Orden de transmisión de los bits hacia los registros 74HC595.
                                 ; Con valor 1 se transmite primero el bit menos significativo.
                                 ; Con valor 0 se transmite primero el bit más significativo.
                                 
                                 .equ DISPLAY_BIT0_PRIMERO = 1
                                 
                                 
                                 ;===============================================================================
                                 ; VECTORES DE INTERRUPCIÓN
                                 ;===============================================================================
                                 
                                 .ORG 0x0000
000000 940c 001e                     jmp inicio
                                 
                                 .ORG 0x0008
000008 940c 0157                     jmp int_botones
                                 
                                 .ORG 0x001C
00001c 940c 0163                     jmp int_timer_display
                                 
                                 
                                 ;===============================================================================
                                 ; RESERVA DE MEMORIA
                                 ;===============================================================================
                                 
                                 .DSEG
                                 
000100                           mensaje_512:            .byte 512    ; Espacio reservado para los datos.
000300                           fin_del_mensaje:        .byte 1      ; Referencia al final del mensaje.
000301                           checksum_recibido:      .byte 4      ; Almacenamiento del checksum recibido.
                                 
                                 
                                 ;===============================================================================
                                 ; PROGRAMA PRINCIPAL
                                 ;===============================================================================
                                 
                                 .CSEG
                                 
                                 inicio:
00001e 940e 00d6                     call configurar_placa
                                 
000020 e0a0                          ldi r26, 0x00
000021 2e7a                          mov r7, r26
000022 2e6a                          mov r6, r26
000023 2e5a                          mov r5, r26
000024 2e4a                          mov r4, r26
                                 
000025 9478                          sei                              ; Activación de las interrupciones.
                                 
000026 940c 0028                     jmp modo_transmisor              ; Configuración para la placa transmisora.
                                 ;   jmp modo_receptor                ; Utilizar esta opción en la placa receptora.
                                 
                                 
                                 ;===============================================================================
                                 ; FUNCIONAMIENTO COMO TRANSMISOR
                                 ;===============================================================================
                                 
                                 modo_transmisor:
                                 
                                     ; Estado inicial del generador de números pseudoaleatorios.
000028 ea03                          ldi r16, 0xA3
000029 e812                          ldi r17, 0x82
00002a ef20                          ldi r18, 0xF0
00002b e035                          ldi r19, 0x05
                                 
                                 transmisor_repetir:
                                 
00002c d0d5                          rcall generar_aleatorios
                                 
                                     ; Conservar el estado del generador para la siguiente transmisión.
00002d 0148                          movw r8, r16
00002e 0159                          movw r10, r18
                                 
00002f d025                          rcall calcular_checksum
                                 
                                     ; Esperar una nueva pulsación.
000030 e0a0                          ldi r26, 0
                                 
                                 transmisor_espera_boton:
                                 
000031 ffa0                          sbrs r26, 0
000032 cffe                          rjmp transmisor_espera_boton
                                 
000033 d010                          rcall esperar_boton_suelto
                                 
                                     ; Durante el envío se suspenden las interrupciones.
000034 94f8                          cli
000035 d032                          rcall enviar_mensaje
000036 9478                          sei
                                 
                                     ; Recuperar el estado del generador XORSHIFT.
000037 0184                          movw r16, r8
000038 0195                          movw r18, r10
                                 
000039 cff2                          rjmp transmisor_repetir
                                 
                                 
                                 ;===============================================================================
                                 ; FUNCIONAMIENTO COMO RECEPTOR
                                 ;===============================================================================
                                 
                                 modo_receptor:
                                 
00003a e0a0                          ldi r26, 0
                                 
                                 receptor_espera_boton:
                                 
00003b ffa0                          sbrs r26, 0
00003c cffe                          rjmp receptor_espera_boton
                                 
00003d d006                          rcall esperar_boton_suelto
                                 
                                     ; Recibir el mensaje completo y su checksum.
00003e 94f8                          cli
00003f d04a                          rcall recibir_mensaje
000040 9478                          sei
                                 
                                     ; Obtener el checksum de los datos almacenados.
000041 d013                          rcall calcular_checksum
                                 
                                     ; Comparar ambos resultados y actualizar los LEDs.
000042 d07b                          rcall verificar_checksum
                                 
000043 cff6                          rjmp modo_receptor
                                 
                                 
                                 ;===============================================================================
                                 ; CONTROL DE BOTONES Y ANTIRREBOTE
                                 ;===============================================================================
                                 
                                 ; Espera inicial, liberación de los botones y espera final.
                                 ; Se utilizan r16, r17 y r18 como registros auxiliares.
                                 
                                 esperar_boton_suelto:
                                 
000044 d006                          rcall pausa_25ms
                                 
                                 soltar_esperando:
                                 
000045 b106                          in r16, PINC
000046 700e                          andi r16, 0b00001110
                                 
000047 300e                          cpi r16, 0b00001110
000048 f7e1                          brne soltar_esperando
                                 
000049 d001                          rcall pausa_25ms
00004a 9508                          ret
                                 
                                 
                                 ; Generación de una demora aproximada de 25 ms.
                                 ; El cálculo está realizado para una frecuencia de 16 MHz.
                                 
                                 pausa_25ms:
                                 
00004b e022                          ldi r18, 2
                                 
                                 pausa_externo:
                                 
00004c e010                          ldi r17, 0
                                 
                                 pausa_medio:
                                 
00004d e000                          ldi r16, 0
                                 
                                 pausa_interno:
                                 
00004e 950a                          dec r16
00004f f7f1                          brne pausa_interno
                                 
000050 951a                          dec r17
000051 f7d9                          brne pausa_medio
                                 
000052 952a                          dec r18
000053 f7c1                          brne pausa_externo
                                 
000054 9508                          ret
                                 
                                 
                                 ;===============================================================================
                                 ; CÁLCULO DEL CHECKSUM
                                 ;===============================================================================
                                 
                                 ; Recorre el bloque completo y acumula el valor de cada byte.
                                 ; El resultado se conserva en cuatro registros para evitar desbordamientos.
                                 ;
                                 ; r15:r14:r13:r12 = acumulador temporal.
                                 ; r7:r6:r5:r4     = resultado definitivo.
                                 
                                 calcular_checksum:
                                 
                                     ; Dirección inicial del bloque de datos.
000055 e0c0                          ldi YL, low(mensaje_512)
000056 e0d1                          ldi YH, high(mensaje_512)
                                 
                                     ; Reiniciar el acumulador.
000057 24cc                          clr r12
000058 24dd                          clr r13
000059 24ee                          clr r14
00005a 24ff                          clr r15
00005b 2711                          clr r17
                                 
                                 checksum_sumar_byte:
                                 
                                     ; Leer el siguiente elemento.
00005c 9109                          ld r16, Y+
                                 
                                     ; Incorporar el valor al acumulador de 32 bits.
00005d 0ec0                          add r12, r16
00005e 1ed1                          adc r13, r17
00005f 1ee1                          adc r14, r17
000060 1ef1                          adc r15, r17
                                 
                                     ; Comprobar si se procesaron los 512 bytes.
000061 30c0                          cpi YL, low(fin_del_mensaje)
000062 f7c9                          brne checksum_sumar_byte
                                 
000063 30d3                          cpi YH, high(fin_del_mensaje)
000064 f7b9                          brne checksum_sumar_byte
                                 
                                     ; Copiar el resultado definitivo.
000065 0126                          movw r4, r12
000066 0137                          movw r6, r14
                                 
000067 9508                          ret
                                 
                                 
                                 ;===============================================================================
                                 ; TRANSMISIÓN MEDIANTE USART
                                 ;===============================================================================
                                 
                                 ; Envía primero el contenido del vector y después el checksum.
                                 ; El orden de los bytes del checksum es de menor a mayor significancia.
                                 
                                 enviar_mensaje:
                                 
                                     ; Posicionar el puntero al comienzo del mensaje.
000068 e0e0                          ldi ZL, low(mensaje_512)
000069 e0f1                          ldi ZH, high(mensaje_512)
                                 
                                     ; Habilitar únicamente el transmisor.
00006a e008                          ldi r16, (1<<TXEN0)
00006b 9300 00c1                     sts UCSR0B, r16
                                 
                                     ; Configurar velocidad y limpiar la bandera de transmisión.
00006d e400                          ldi r16, (1<<TXC0)|(VALOR_U2X<<U2X0)
00006e 9300 00c0                     sts UCSR0A, r16
                                 
                                 enviar_los_512_bytes:
                                 
                                     ; Obtener el siguiente byte y transmitirlo.
000070 9101                          ld r16, Z+
000071 d011                          rcall enviar_un_byte
                                 
                                     ; Comprobar si se alcanzó el final del vector.
000072 30e0                          cpi ZL, low(fin_del_mensaje)
000073 f7e1                          brne enviar_los_512_bytes
                                 
000074 30f3                          cpi ZH, high(fin_del_mensaje)
000075 f7d1                          brne enviar_los_512_bytes
                                 
                                 
                                 ; Envío de los cuatro bytes que forman el checksum.
                                 
                                 enviar_los_4_del_checksum:
                                 
000076 2d04                          mov r16, r4
000077 d00b                          rcall enviar_un_byte
                                 
000078 2d05                          mov r16, r5
000079 d009                          rcall enviar_un_byte
                                 
00007a 2d06                          mov r16, r6
00007b d007                          rcall enviar_un_byte
                                 
00007c 2d07                          mov r16, r7
00007d d005                          rcall enviar_un_byte
                                 
                                 
                                 ; Confirmar que el último byte terminó de salir por el puerto serial.
                                 
                                 esperar_fin_envio:
                                 
00007e 9110 00c0                     lds r17, UCSR0A
000080 ff16                          sbrs r17, TXC0
000081 cffc                          rjmp esperar_fin_envio
                                 
000082 9508                          ret
                                 
                                 
                                 ; Transmisión individual de un byte almacenado en r16.
                                 ; Antes de escribir UDR0 se comprueba que el registro esté disponible.
                                 
                                 enviar_un_byte:
                                 
000083 9110 00c0                     lds r17, UCSR0A
000085 ff15                          sbrs r17, UDRE0
000086 cffc                          rjmp enviar_un_byte
                                 
000087 9300 00c6                     sts UDR0, r16
                                 
000089 9508                          ret
                                 
                                 
                                 ;===============================================================================
                                 ; RECEPCIÓN MEDIANTE USART
                                 ;===============================================================================
                                 
                                 ; Recibe los 512 bytes de información y los cuatro bytes del checksum.
                                 ; La recepción se realiza mediante consulta periódica de las banderas USART.
                                 
                                 recibir_mensaje:
                                 
                                     ; Establecer el destino de los datos recibidos.
00008a e0e0                          ldi ZL, low(mensaje_512)
00008b e0f1                          ldi ZH, high(mensaje_512)
                                 
                                     ; Activar el receptor.
00008c e100                          ldi r16, (1<<RXEN0)
00008d 9300 00c1                     sts UCSR0B, r16
                                 
                                 
                                 ; Descartar cualquier dato anterior que permanezca en el buffer.
                                 
                                 vaciar_receptor:
                                 
00008f 9110 00c0                     lds r17, UCSR0A
000091 ff17                          sbrs r17, RXC0
000092 c003                          rjmp receptor_vacio
                                 
000093 9100 00c6                     lds r16, UDR0
000095 cff9                          rjmp vaciar_receptor
                                 
                                 receptor_vacio:
                                 
000096 2722                          clr r18                         ; Reiniciar indicadores de error.
                                 
                                 
                                 ; Esperar indefinidamente hasta detectar el primer byte de la transmisión.
                                 
                                 esperar_primer_byte:
                                 
000097 9110 00c0                     lds r17, UCSR0A
000099 ff17                          sbrs r17, RXC0
00009a cffc                          rjmp esperar_primer_byte
                                 
                                 
                                 ; A partir del primer byte comienza la recepción con tiempo limitado.
                                 
                                 recibir_los_512_bytes:
                                 
00009b d011                          rcall recibir_un_byte
                                 
00009c f070                          brcs recepcion_fallo_tiempo
                                 
                                     ; Guardar el dato en la posición correspondiente.
00009d 9301                          st Z+, r16
                                 
                                     ; Verificar si se completó el bloque.
00009e 30e0                          cpi ZL, low(fin_del_mensaje)
00009f f7d9                          brne recibir_los_512_bytes
                                 
0000a0 30f3                          cpi ZH, high(fin_del_mensaje)
0000a1 f7c9                          brne recibir_los_512_bytes
                                 
                                 
                                 ; Preparar el almacenamiento de los cuatro bytes adicionales.
                                 
0000a2 e0e1                          ldi ZL, low(checksum_recibido)
0000a3 e0f3                          ldi ZH, high(checksum_recibido)
                                 
0000a4 e034                          ldi r19, 4
                                 
                                 recibir_los_4_del_checksum:
                                 
0000a5 d007                          rcall recibir_un_byte
                                 
0000a6 f020                          brcs recepcion_fallo_tiempo
                                 
0000a7 9301                          st Z+, r16
                                 
0000a8 953a                          dec r19
0000a9 f7d9                          brne recibir_los_4_del_checksum
                                 
0000aa 9508                          ret
                                 
                                 
                                 ; Si se agota el tiempo de espera, indicar que la recepción quedó incompleta.
                                 
                                 recepcion_fallo_tiempo:
                                 
0000ab 6820                          ori r18, 0x80
0000ac 9508                          ret
                                 
                                 
                                 ;===============================================================================
                                 ; RECEPCIÓN DE UN BYTE Y CONTROL DE ERRORES
                                 ;===============================================================================
                                 
                                 ; Espera la llegada de un dato durante un intervalo limitado.
                                 ;
                                 ; Resultado:
                                 ;   r16 = byte recibido.
                                 ;   C = 0 si la recepción fue exitosa.
                                 ;   C = 1 si se agotó el tiempo.
                                 ;
                                 ; Los indicadores FE0, DOR0 y UPE0 se leen antes de acceder a UDR0.
                                 
                                 recibir_un_byte:
                                 
0000ad 2744                          clr r20
0000ae 2755                          clr r21
                                 
                                 esperar_llegada_byte:
                                 
0000af 9110 00c0                     lds r17, UCSR0A
                                 
0000b1 fd17                          sbrc r17, RXC0
0000b2 c005                          rjmp byte_llego
                                 
                                     ; Actualizar el contador de espera.
0000b3 5041                          subi r20, 1
0000b4 4050                          sbci r21, 0
                                 
0000b5 f7c9                          brne esperar_llegada_byte
                                 
0000b6 9408                          sec
0000b7 9508                          ret
                                 
                                 
                                 byte_llego:
                                 
                                     ; Acumular los posibles errores detectados por el hardware.
0000b8 711c                          andi r17, (1<<FE0)|(1<<DOR0)|(1<<UPE0)
                                 
0000b9 2b21                          or r18, r17
                                 
                                     ; Recuperar el dato recibido.
0000ba 9100 00c6                     lds r16, UDR0
                                 
0000bc 9488                          clc
0000bd 9508                          ret
                                 
                                 
                                 ;===============================================================================
                                 ; COMPROBACIÓN DEL CHECKSUM Y CONTROL DE LEDs
                                 ;===============================================================================
                                 
                                 ; Compara byte a byte el checksum local con el recibido.
                                 ;
                                 ; PB5: coincidencia entre ambos valores.
                                 ; PB4: diferencia en el resultado.
                                 ; PB3: errores detectados durante la recepción.
                                 
                                 ; Se utiliza Y para recorrer el checksum recibido porque la rutina
                                 ; de actualización del display utiliza el registro Z.
                                 
                                 verificar_checksum:
                                 
                                     ; Apagar inicialmente los tres indicadores.
0000be 9a2d                          sbi PORTB, 5
0000bf 9a2c                          sbi PORTB, 4
0000c0 9a2b                          sbi PORTB, 3
                                 
                                     ; Comprobar si se produjo algún error de hardware.
0000c1 2322                          tst r18
0000c2 f009                          breq revisar_checksum
                                 
0000c3 982b                          cbi PORTB, 3
                                 
                                 revisar_checksum:
                                 
0000c4 e0c1                          ldi YL, low(checksum_recibido)
0000c5 e0d3                          ldi YH, high(checksum_recibido)
                                 
                                     ; Comparación del byte menos significativo.
0000c6 9109                          ld r16, Y+
0000c7 1504                          cp r16, r4
0000c8 f459                          brne checksum_distinto
                                 
0000c9 9109                          ld r16, Y+
0000ca 1505                          cp r16, r5
0000cb f441                          brne checksum_distinto
                                 
0000cc 9109                          ld r16, Y+
0000cd 1506                          cp r16, r6
0000ce f429                          brne checksum_distinto
                                 
0000cf 9109                          ld r16, Y+
0000d0 1507                          cp r16, r7
0000d1 f411                          brne checksum_distinto
                                 
                                     ; Todos los bytes coinciden.
0000d2 982d                          cbi PORTB, 5
                                 
0000d3 9508                          ret
                                 
                                 
                                 checksum_distinto:
                                 
                                     ; Señalizar que los valores no son iguales.
0000d4 982c                          cbi PORTB, 4
                                 
0000d5 9508                          ret
                                 
                                 
                                 ;===============================================================================
                                 ; CONFIGURACIÓN INICIAL DEL HARDWARE
                                 ;===============================================================================
                                 
                                 configurar_placa:
                                 
                                     ;---------------------------------------------------------------------------
                                     ; Configuración de los puertos de entrada y salida.
                                     ;
                                     ; PORTB:
                                     ;   PB2-PB5: LEDs de indicación.
                                     ;   PB0: línea de datos del display.
                                     ;
                                     ; PORTC:
                                     ;   PC1-PC3: entradas correspondientes a los botones.
                                     ;
                                     ; PORTD:
                                     ;   PD0: recepción USART.
                                     ;   PD4: señal de latch del display.
                                     ;   PD7: reloj de los registros de desplazamiento.
                                     ;---------------------------------------------------------------------------
                                 
0000d6 e30d                          ldi r16, 0b00111101
0000d7 b904                          out DDRB, r16
0000d8 b905                          out PORTB, r16
                                 
0000d9 e000                          ldi r16, 0b00000000
0000da b907                          out DDRC, r16
                                 
0000db e00e                          ldi r16, 0b00001110
0000dc b908                          out PORTC, r16
                                 
0000dd e900                          ldi r16, 0b10010000
0000de b90a                          out DDRD, r16
                                 
                                     ; Mantener la entrada RXD en estado de reposo.
0000df 9a58                          sbi PORTD, 0
                                 
                                     ; Estado inicial de las señales del display.
0000e0 985f                          cbi PORTD, 7
0000e1 985c                          cbi PORTD, 4
                                 
                                 
                                     ;---------------------------------------------------------------------------
                                     ; Habilitación de interrupciones por cambio de estado en los botones.
                                     ;---------------------------------------------------------------------------
                                 
0000e2 e002                          ldi r16, 0b00000010
0000e3 9300 0068                     sts PCICR, r16
                                 
0000e5 e00e                          ldi r16, 0b00001110
0000e6 9300 006c                     sts PCMSK1, r16
                                 
                                 
                                     ;---------------------------------------------------------------------------
                                     ; Configuración del temporizador 0 para actualizar el display.
                                     ;---------------------------------------------------------------------------
                                 
0000e8 e002                          ldi r16, 0b00000010
0000e9 bd04                          out TCCR0A, r16
                                 
0000ea e004                          ldi r16, 0b00000100
0000eb bd05                          out TCCR0B, r16
                                 
0000ec ef09                          ldi r16, 249
0000ed bd07                          out OCR0A, r16
                                 
0000ee e002                          ldi r16, 0b00000010
0000ef 9300 006e                     sts TIMSK0, r16
                                 
                                 
                                     ;---------------------------------------------------------------------------
                                     ; Parámetros de comunicación serial.
                                     ; Transmisión asíncrona, ocho bits de datos, paridad par y un bit de parada.
                                     ;---------------------------------------------------------------------------
                                 
0000f1 e008                          ldi r16, 0b00001000
0000f2 9300 00c1                     sts UCSR0B, r16
                                 
0000f4 e206                          ldi r16, 0b00100110
                                 ;   ldi r16, 0b00000110           ; Alternativa de configuración sin paridad.
0000f5 9300 00c2                     sts UCSR0C, r16
                                 
0000f7 e000                          ldi r16, (VALOR_U2X<<U2X0)
0000f8 9300 00c0                     sts UCSR0A, r16
                                 
0000fa e000                          ldi r16, high(VALOR_UBRR)
0000fb 9300 00c5                     sts UBRR0H, r16
                                 
0000fd e607                          ldi r16, low(VALOR_UBRR)
0000fe 9300 00c4                     sts UBRR0L, r16
                                 
                                 
                                     ;---------------------------------------------------------------------------
                                     ; Valor inicial para la selección de los dígitos del display.
                                     ;---------------------------------------------------------------------------
                                 
000100 e190                          ldi r25, 0x10
                                 
000101 9508                          ret
                                 
                                 
                                 ;===============================================================================
                                 ; GENERACIÓN DE DATOS PSEUDOALEATORIOS
                                 ;===============================================================================
                                 
                                 ; Llena el vector mensaje_512 con 512 bytes.
                                 ; Cada iteración genera un nuevo número de 32 bits mediante XORSHIFT.
                                 
                                 generar_aleatorios:
                                 
                                     ; Ubicar el puntero Y al principio de la memoria reservada.
000102 e0c0                          ldi r28, low(mensaje_512)
000103 e0d1                          ldi r29, high(mensaje_512)
                                 
                                 aleatorios_nuevo_numero:
                                 
                                     ; Aplicar las tres transformaciones del algoritmo XORSHIFT.
000104 e04d                          ldi r20, 13
000105 940e 0116                     call desplazar_izquierda_xor
                                 
000107 e141                          ldi r20, 17
000108 940e 0122                     call desplazar_derecha_xor
                                 
00010a e045                          ldi r20, 5
00010b 940e 0116                     call desplazar_izquierda_xor
                                 
                                     ; Guardar los cuatro bytes generados.
00010d 9309                          st Y+, r16
00010e 9319                          st Y+, r17
00010f 9329                          st Y+, r18
000110 9339                          st Y+, r19
                                 
                                     ; Continuar mientras queden posiciones disponibles.
000111 30c0                          cpi YL, low(fin_del_mensaje)
000112 f789                          brne aleatorios_nuevo_numero
                                 
000113 30d3                          cpi YH, high(fin_del_mensaje)
000114 f779                          brne aleatorios_nuevo_numero
                                 
000115 9508                          ret
                                 
                                 
                                 ; Desplazamiento hacia la izquierda seguido de una operación XOR.
                                 ; x = x XOR (x << desplazamiento)
                                 
                                 desplazar_izquierda_xor:
                                 
                                     ; Copiar el estado actual para realizar la transformación.
000116 2e00                          mov r0, r16
000117 2e11                          mov r1, r17
000118 2e22                          mov r2, r18
000119 2e33                          mov r3, r19
                                 
                                 izquierda_un_bit:
                                 
00011a 9488                          clc
                                 
00011b 1c00                          rol r0
00011c 1c11                          rol r1
00011d 1c22                          rol r2
00011e 1c33                          rol r3
                                 
00011f 954a                          dec r20
000120 f7c9                          brne izquierda_un_bit
                                 
000121 c00b                          rjmp mezclar_xor
                                 
                                 
                                 ; Desplazamiento hacia la derecha seguido de una operación XOR.
                                 ; x = x XOR (x >> desplazamiento)
                                 
                                 desplazar_derecha_xor:
                                 
000122 2e00                          mov r0, r16
000123 2e11                          mov r1, r17
000124 2e22                          mov r2, r18
000125 2e33                          mov r3, r19
                                 
                                 derecha_un_bit:
                                 
000126 9488                          clc
                                 
000127 9437                          ror r3
000128 9427                          ror r2
000129 9417                          ror r1
00012a 9407                          ror r0
                                 
00012b 954a                          dec r20
00012c f7c9                          brne derecha_un_bit
                                 
                                 
                                 ; Combinar el valor original con la copia desplazada.
                                 
                                 mezclar_xor:
                                 
00012d 2500                          eor r16, r0
00012e 2511                          eor r17, r1
00012f 2522                          eor r18, r2
000130 2533                          eor r19, r3
                                 
000131 9508                          ret
                                 
                                 
                                 ;===============================================================================
                                 ; CONTROL DEL DISPLAY DE SIETE SEGMENTOS
                                 ;===============================================================================
                                 
                                 ; Recibe en r16 la información que se desea representar:
                                 ;
                                 ;   Nibble superior: posición del dígito que se activa.
                                 ;   Nibble inferior: valor hexadecimal que se muestra.
                                 ;
                                 ; Ejemplo:
                                 ;   r16 = 0x47 representa el número 7 en el segundo dígito.
                                 
                                 mostrar_digito:
                                 
                                     ; Conservar el valor original para enviarlo posteriormente.
000132 930f                          push r16
                                 
                                     ; Obtener la dirección de la tabla de conversión.
000133 e0f2                          ldi zh, high(tabla_7segmentos<<1)
000134 e9ee                          ldi zl, low(tabla_7segmentos<<1)
                                 
                                     ; Seleccionar el patrón correspondiente al número.
000135 700f                          andi r16, 0x0F
                                 
000136 0fe0                          add zl, r16
                                 
000137 2700                          clr r16
000138 1ff0                          adc zh, r16
                                 
                                     ; Leer el patrón desde la memoria de programa.
000139 9104                          lpm r16, Z
                                 
00013a 940e 0142                     call enviar_byte_display
                                 
                                     ; Enviar la selección del dígito.
00013c 910f                          pop r16
                                 
00013d 940e 0142                     call enviar_byte_display
                                 
                                     ; Actualizar las salidas de los registros 74HC595.
00013f 9a5c                          sbi PORTD, 4
000140 985c                          cbi PORTD, 4
                                 
000141 9508                          ret
                                 
                                 
                                 ;===============================================================================
                                 ; ENVÍO DE DATOS AL DISPLAY
                                 ;===============================================================================
                                 
                                 ; Envía los ocho bits de r16 por PB0.
                                 ; Cada bit transmitido genera un pulso de reloj en PD7.
                                 ; El registro r17 se conserva durante la ejecución.
                                 
                                 enviar_byte_display:
                                 
000142 931f                          push r17
                                 
000143 e018                          ldi r17, 8
                                 
                                 display_bit_siguiente:
                                 
                                 .if DISPLAY_BIT0_PRIMERO
                                 
                                     ; Desplazar el bit menos significativo hacia el carry.
000144 9507                          ror r16
                                 
                                 .else
                                 .endif
                                 
000145 f010                          brcs display_bit_uno
                                 
                                     ; Colocar un cero en la línea de datos.
000146 9828                          cbi PORTB, 0
                                 
000147 c001                          rjmp display_pulso_reloj
                                 
                                 
                                 display_bit_uno:
                                 
                                     ; Colocar un uno en la línea de datos.
000148 9a28                          sbi PORTB, 0
                                 
                                 
                                 display_pulso_reloj:
                                 
                                     ; Pulso de desplazamiento para almacenar el siguiente bit.
000149 9a5f                          sbi PORTD, 7
00014a 985f                          cbi PORTD, 7
                                 
00014b 951a                          dec r17
00014c f7b9                          brne display_bit_siguiente
                                 
00014d 911f                          pop r17
                                 
00014e 9508                          ret
                                 
                                 
                                 ;===============================================================================
                                 ; TABLA DE CONVERSIÓN HEXADECIMAL A SIETE SEGMENTOS
                                 ;===============================================================================
                                 
                                 ; Patrones correspondientes a los valores 0-F.
                                 ; La configuración corresponde a un display de ánodo común.
                                 ; El segmento se enciende cuando su salida se encuentra en cero.
                                 
                                 tabla_7segmentos:
                                 
                                 .if DISPLAY_BIT0_PRIMERO
                                 
00014f 9f03
000150 0d25
000151 4999
000152 1f41                          .db 0x03, 0x9F, 0x25, 0x0D, 0x99, 0x49, 0x41, 0x1F
000153 0901
000154 c111
000155 8563
000156 7161                          .db 0x01, 0x09, 0x11, 0xC1, 0x63, 0x85, 0x61, 0x71
                                 
                                 .else
                                 .endif
                                 
                                 
                                 ;===============================================================================
                                 ; INTERRUPCIÓN ASOCIADA A LOS BOTONES
                                 ;===============================================================================
                                 
                                 ; Se ejecuta cuando cambia el estado de alguno de los pines PC1-PC3.
                                 ; La bandera se activa únicamente cuando se detecta un botón presionado.
                                 
                                 int_botones:
                                 
000157 930f                          push r16
                                 
                                     ; Guardar el estado actual de los indicadores del procesador.
000158 b70f                          in r16, SREG
000159 930f                          push r16
                                 
                                     ; Consultar el estado de las entradas.
00015a b106                          in r16, PINC
00015b 700e                          andi r16, 0b00001110
                                 
                                     ; Si todos están en uno, no hay botones presionados.
00015c 300e                          cpi r16, 0b00001110
00015d f009                          breq int_botones_fin
                                 
                                     ; Informar al programa principal que hubo una pulsación.
00015e 60a1                          ori r26, 0x01
                                 
                                 
                                 int_botones_fin:
                                 
                                     ; Recuperar los registros y el estado del procesador.
00015f 910f                          pop r16
000160 bf0f                          out SREG, r16
                                 
000161 910f                          pop r16
                                 
000162 9518                          reti
                                 
                                 
                                 ;===============================================================================
                                 ; INTERRUPCIÓN DEL TEMPORIZADOR: ACTUALIZACIÓN DEL DISPLAY
                                 ;===============================================================================
                                 
                                 ; Esta rutina se ejecuta periódicamente mediante el Timer0.
                                 ; En cada llamada se actualiza uno de los cuatro dígitos del display.
                                 ;
                                 ; Secuencia controlada por r25:
                                 ;
                                 ;   0x10 -> Nibble superior de r5.
                                 ;   0x20 -> Nibble inferior de r5.
                                 ;   0x40 -> Nibble superior de r4.
                                 ;   0x80 -> Nibble inferior de r4.
                                 ;
                                 ; Al finalizar la secuencia se vuelve al primer dígito.
                                 
                                 int_timer_display:
                                 
                                     ; Guardar los registros utilizados durante la interrupción.
000163 930f                          push r16
                                 
000164 b70f                          in r16, SREG
000165 930f                          push r16
                                 
000166 93ef                          push r30
000167 93ff                          push r31
                                 
                                 
                                     ;---------------------------------------------------------------------------
                                     ; Seleccionar el byte y el nibble que corresponde mostrar.
                                     ;---------------------------------------------------------------------------
                                 
000168 3190                          cpi r25, 0x10
000169 f419                          brne timer_probar_digito_2
                                 
00016a 2de5                          mov r30, r5
00016b 95e2                          swap r30
                                 
00016c c00a                          rjmp timer_dibujar
                                 
                                 
                                 timer_probar_digito_2:
                                 
00016d 3290                          cpi r25, 0x20
00016e f411                          brne timer_probar_digito_3
                                 
00016f 2de5                          mov r30, r5
                                 
000170 c006                          rjmp timer_dibujar
                                 
                                 
                                 timer_probar_digito_3:
                                 
000171 3490                          cpi r25, 0x40
000172 f419                          brne timer_digito_4
                                 
000173 2de4                          mov r30, r4
000174 95e2                          swap r30
                                 
000175 c001                          rjmp timer_dibujar
                                 
                                 
                                 timer_digito_4:
                                 
000176 2de4                          mov r30, r4
                                 
                                 
                                     ;---------------------------------------------------------------------------
                                     ; Preparar el valor y enviarlo al display.
                                     ;---------------------------------------------------------------------------
                                 
                                 timer_dibujar:
                                 
000177 70ef                          andi r30, 0x0F
                                 
000178 2f09                          mov r16, r25
000179 2b0e                          or r16, r30
                                 
00017a 940e 0132                     call mostrar_digito
                                 
                                 
                                     ;---------------------------------------------------------------------------
                                     ; Avanzar a la siguiente posición del display.
                                     ;---------------------------------------------------------------------------
                                 
00017c 0f99                          lsl r25
                                 
00017d f409                          brne timer_fin
                                 
00017e e190                          ldi r25, 0x10
                                 
                                 
                                 timer_fin:
                                 
                                     ; Restaurar todos los registros antes de salir.
00017f 91ff                          pop r31
000180 91ef                          pop r30
                                 
000181 910f                          pop r16
000182 bf0f                          out SREG, r16
                                 
000183 910f                          pop r16
                                 
000184 9518                          reti


